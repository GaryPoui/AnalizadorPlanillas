# ──────────────────────────────────────────────────────
# PriceBot — Variables de entorno
# Copiar este archivo a .env y completar los valores.
# ──────────────────────────────────────────────────────

# [PRIVACIDAD] La IA externa está desactivada por defecto.
# Activarla implica enviar contenido extraído de PDF e imágenes a Anthropic.
PRICEBOT_ALLOW_EXTERNAL_AI=0
ANTHROPIC_API_KEY=

# [COMPATIBILIDAD] Clave opcional para clientes internos sin login.
# No colocar este secreto en frontend/app.js ni usarlo como reemplazo del login.
# PRICEBOT_API_KEY=generar-una-clave-larga-y-aleatoria

# [SEGURIDAD] Orígenes web exactos permitidos, separados por coma
PRICEBOT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://127.0.0.1:3000,https://localhost:3000,https://192.168.190.146:3000
PRICEBOT_REQUIRE_HTTPS=1
PRICEBOT_ENABLE_API_DOCS=0

# [SEGURIDAD] No guardar filas completas en Respuestas/history por defecto
SAVE_HISTORY=0
PRICEBOT_LOG_FILENAMES=0
TRANSFORM_CACHE_MAX_ITEMS=0
PRICEBOT_MAX_UPLOAD_MB=50
PRICEBOT_MAX_BATCH_FILES=10
PRICEBOT_MAX_BATCH_MB=100
PRICEBOT_MAX_ARCHIVE_UNCOMPRESSED_MB=200
PRICEBOT_MAX_PDF_PAGES=300

# [OPCIONAL] Ruta al binario de Tesseract OCR (para PDFs escaneados)
# Descargar: https://github.com/UB-Mannheim/tesseract/wiki
# TESSERACT_CMD=C:\Users\TU_USUARIO\AppData\Local\Programs\Tesseract-OCR\tesseract.exe

# [OPCIONAL] Modelo a usar. Default: claude-sonnet-4-5
# CLAUDE_MODEL=claude-sonnet-4-5

# ──────────────────────────────────────────────────────
# [SEGURIDAD] Acceso por usuarios autorizados
# Generar cada registro con:
#   python pricebot/api/create_password_hash.py nombre_usuario
# Luego separar varios usuarios con comas.
# No guardar contraseñas en texto plano.
PRICEBOT_AUTH_REQUIRED=1
# PRICEBOT_SESSION_SECRET=GENERAR_UNA_CLAVE_ALEATORIA_LARGA
PRICEBOT_COOKIE_SECURE=1
PRICEBOT_SESSION_TTL_SEC=28800
PRICEBOT_LOGIN_MAX_ATTEMPTS=5
PRICEBOT_LOGIN_WINDOW_SEC=900
# PRICEBOT_USERS=usuario$SAL$HASH,otro$SAL$HASH

# Alta de usuarios por correo desde la PC servidor
# Abrir el frontend como http://127.0.0.1:3000 en el servidor para administrar.
# El enlace debe ser accesible por las PCs que recibirán la invitación.
# PRICEBOT_PUBLIC_URL=https://192.168.190.146:3000
# PRICEBOT_CONFIRMATION_TTL_SEC=86400
# PRICEBOT_USERS_DB=C:\ruta\privada\pricebot-users.db

# Servidor de correo (ejemplo genérico STARTTLS, puerto 587)
# PRICEBOT_SMTP_HOST=smtp.proveedor.com
# PRICEBOT_SMTP_PORT=587
# PRICEBOT_SMTP_USERNAME=cuenta@empresa.com
# PRICEBOT_SMTP_PASSWORD=CLAVE_O_PASSWORD_DE_APLICACION
# PRICEBOT_SMTP_FROM=cuenta@empresa.com
# PRICEBOT_SMTP_STARTTLS=1
# PRICEBOT_SMTP_SSL=0
